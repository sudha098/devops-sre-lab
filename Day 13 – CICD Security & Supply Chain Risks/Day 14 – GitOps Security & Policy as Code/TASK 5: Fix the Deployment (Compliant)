data:
  name: good-app
spec:
  replicas: 1
  selector:
    matchLabels:
      app: good-app
  template:
    metadata:
      labels:
        app: good-app
    spec:
      containers:
      - name: app
        image: nginx
        resources:
          limits:
            cpu: "200m"
            memory: "256Mi"
EOF

